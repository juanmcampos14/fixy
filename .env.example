# ── Fixy · variables de entorno de ejemplo ──
# Copiá este archivo a .env.local y ajustá los valores. Nunca subas secretos reales al repositorio.

# Base de datos (local: docker compose up -d). En Supabase: cadena de conexión del pooler en modo sesión.
DATABASE_URL=postgres://fixy:fixy_local_only@localhost:54329/fixy
# Base usada por las pruebas automatizadas (se recrea en cada corrida).
TEST_DATABASE_URL=postgres://fixy:fixy_local_only@localhost:54329/fixy_test

APP_URL=http://localhost:3000

# Secreto para firmar URLs temporales de archivos privados (mínimo 32 caracteres).
FILE_SIGNING_SECRET=change-me-local-file-signing-secret-000000
# Directorio del almacenamiento privado local (adaptador "local"). En producción: Supabase Storage privado.
STORAGE_DRIVER=local
STORAGE_DIR=./.data/storage

# Pagos: "mock" (modo de prueba, sin dinero real) o "mercadopago" (requiere credenciales y validación comercial).
PAYMENTS_GATEWAY=mock
MOCK_WEBHOOK_SECRET=change-me-mock-webhook-secret-0000000000
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Email: "console" registra los envíos en la consola y en la tabla delivery_attempts.
EMAIL_ADAPTER=console
EMAIL_FROM="Fixy <no-responder@fixy.solutions>"

# Asistente: "rules" (por defecto, sin servicios externos) o "claude" (opcional, requiere API key).
ASSISTANT_PROVIDER=rules
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5-5
ASSISTANT_TIMEOUT_MS=8000

# Accesos de demostración (selector de usuarios de prueba). Se ignora siempre en NODE_ENV=production.
DEMO_MODE=true

# Token para disparar el procesador del outbox vía HTTP (cron externo).
CRON_SECRET=change-me-cron-secret-000000000000

# Supabase Storage (producción): STORAGE_DRIVER=supabase + bucket PRIVADO. La service role key es solo de servidor.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=fixy-private

# Email real (opcional): EMAIL_ADAPTER=resend + RESEND_API_KEY y EMAIL_FROM con dominio verificado.
RESEND_API_KEY=

# Solo para un entorno PÚBLICO DE DEMOSTRACIÓN separado (nunca en el de clientes reales):
# ALLOW_DEMO_SEED=true
# DEMO_SEED_PASSWORD=

# Segundo factor del equipo: clave para cifrar los secretos (generala con: openssl rand -base64 48). Obligatoria en producción.
MFA_ENCRYPTION_KEY=
