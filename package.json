{
  "name": "fixy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:up": "docker compose up -d --wait",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/migrate.ts --reset && rm -rf .data/storage && tsx scripts/seed.ts --demo",
    "outbox": "tsx scripts/process-outbox.ts",
    "setup": "npm run db:up && npm run db:reset",
    "admin:create": "tsx scripts/create-admin.ts",
    "semgrep": "bash scripts/semgrep.sh scan --config .semgrep/fixy.yml --config p/secrets --config p/typescript --config p/react --config p/nextjs --config p/owasp-top-ten src/ scripts/",
    "semgrep:arch": "bash scripts/semgrep.sh scan --metrics=off --config .semgrep/fixy.yml src/ scripts/",
    "semgrep:sec": "bash scripts/semgrep.sh scan --config p/secrets --config p/typescript --config p/react --config p/nextjs --config p/owasp-top-ten src/ scripts/"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "@react-three/fiber": "^9.3.0",
    "@supabase/supabase-js": "^2.117.3",
    "clsx": "^2.1.1",
    "jose": "6.1.3",
    "lucide-react": "^1.53.0",
    "next": "^16.4.0",
    "postgres": "^3.4.9",
    "qrcode": "1.5.4",
    "react": "19.2",
    "react-dom": "19.2",
    "server-only": "^0.0.1",
    "three": "^0.180.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.1",
    "@types/qrcode": "1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.180.0",
    "dotenv": "^18.0.6",
    "eslint": "^9",
    "eslint-config-next": "^16.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20.9"
  }
}
